# NestJS API Environment Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Paste your Google Cloud SQL / PostgreSQL credentials here)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
DATABASE_URL="postgresql://lms_app:YOUR_PASSWORD@YOUR_PUBLIC_IP:5432/bible-institute-lms-database?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET="super-secure-dev-secret-change-in-production-bible-lms-key-32chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Development OTP bypass (Set to true for local testing with fixed code 123456)
AUTH_DEV_OTP=true

# Firebase Service Account (optional when AUTH_DEV_OTP=true)
FIREBASE_PROJECT_ID="bible-institute-lms"
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
